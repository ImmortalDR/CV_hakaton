# Generate .env with python3 scripts/configure.py; never use real personal data on demo.
POSTGRES_PASSWORD=replace_with_random_value
DEMO_MODE=true
PUBLIC_URL=http://localhost:3080
BIND_ADDRESS=127.0.0.1
COOKIE_SECURE=false
# Optional public HTTPS on Linux; set PUBLIC_URL=https://<HTTPS_HOST>,
# COOKIE_SECURE=true and keep BIND_ADDRESS=127.0.0.1 when enabling this profile.
# COMPOSE_PROFILES=https
# HTTPS_HOST=85-137-26-131.sslip.io
# Optional aliases redirect to HTTPS_HOST; use comma-separated site addresses.
# HTTPS_SITE_ADDRESSES=85-137-26-131.sslip.io, 85.137.26.131
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.org
